# Copy this file to .env and fill in your values
POSTGRES_PASSWORD=changeme
BREVO_API_KEY=your_brevo_api_key_here
APP_SECRET=change_me_to_a_32_char_random_string
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
APP_URL=http://localhost:8000

# Cloudflare R2 (S3 Compatible) - fotos de servicios
# Account ID en dash.cloudflare.com → R2
R2_ACCOUNT_ID=
# Token con permisos Object Read & Write sobre el bucket
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=dulzia-salamanca
# Bucket → Settings → Public access → r2.dev subdomain
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
